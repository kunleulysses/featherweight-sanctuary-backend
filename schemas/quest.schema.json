{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["quest_id","title","synopsis","stages"],
  "properties": {
    "quest_id": {"type":"string"},
    "title": {"type":"string"},
    "synopsis": {"type":"string"},
    "tags": {"type":"array","items":{"type":"string"}},
    "preconditions": {"type":"array","items":{"type":"object"}},
    "stages": {"type":"array","minItems":1},
    "npcs": {"type":"array","items":{"type":"string"}},
    "rewards": {"type":"array"},
    "music_cues": {"type":"array"},
    "camera_style": {"type":"string"}
  }
}
